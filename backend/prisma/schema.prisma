model Route {
  id          Int      @id @default(autoincrement())
  userId      String
  name        String
  grade       String
  picture     String
  description String?
  sctive      Boolean
  setDate     DateTime
  user        User     @relation(fields: [userId], references: [sub])
  tries       Int      @default(0)
  completed   Boolean  @default(false)
  rating      Int      @default(0)
  //attempts    UserRoute[]
}

